# Neon Postgres (pooled connection string recommended)
DATABASE_URL=

# Neon AI Gateway credentials for the production branch
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_CHAT_MODEL=gpt-5-mini
NEON_EMBEDDING_MODEL=qwen3-embedding-0-6b

# Pinecone serverless index: create a dense-vector index with 1024 dimensions
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=frpboy-portfolio-knowledge
PINECONE_NAMESPACE=portfolio

# Protect the server-side knowledge ingestion endpoint
KNOWLEDGE_INGEST_TOKEN=
PORTFOLIO_RATE_LIMIT_SECRET=

# Cal.com public event link; optional until the event type is created
CALCOM_BOOKING_URL=
# Optional for future booking API/webhook management
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# Neon Object Storage values can be added when source-file uploads are enabled
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# NEON_OBJECT_STORAGE_BUCKET=
