# Neon Postgres (pooled connection string recommended)
DATABASE_URL=

# Neon Object Storage (private bucket; storage:write credential)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_OBJECT_STORAGE_BUCKET=portfolio-knowledge

# Neon AI Gateway is used only for final assistant answer generation
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_CHAT_MODEL=gpt-5-mini

# Pinecone Documents API with integrated llama-text-embed-v2 embeddings
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=frpboy-portfolio-knowledge
PINECONE_NAMESPACE=portfolio

# Protect server-side knowledge ingestion and rate-limit hashing
KNOWLEDGE_INGEST_TOKEN=
PORTFOLIO_RATE_LIMIT_SECRET=

# Cal.com public event link + signed booking webhook secret
CALCOM_BOOKING_URL=
CALCOM_WEBHOOK_SECRET=
